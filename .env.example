PORT=8787
DATABASE_URL=./data/ai-fix-runner.sqlite
WORKSPACE_ROOT=./tmp/workspaces
UPLOAD_ROOT=./tmp/uploads
KEEP_WORKSPACES=false
ALLOW_CUSTOM_REPO_PATHS=false
MAX_STDIO_BYTES=200000

# Runner selection ------------------------------------------------------------
# RUNNER_DEFAULT decides what `runner` is used when POST /api/runs omits the
# field. Valid values: local, tensorlake. Falls back to local when tensorlake
# is requested but TENSORLAKE_API_KEY is not set.
RUNNER_DEFAULT=tensorlake

# Tensorlake runner (optional). When TENSORLAKE_API_KEY is unset, the
# tensorlake runner is disabled and /api/config reports configured=false.
# Get a key from https://docs.tensorlake.ai/platform/authentication
TENSORLAKE_API_KEY=tl_apiKey_cnfmCFptnBK6KbJCBWWTk_1Je6CuN1g_hCHKliHhS1rA-Jk_7UG-

# Optional resource knobs. Leave blank to use Tensorlake's managed defaults
# (the default sandbox image already has Node and npm pre-installed).
TENSORLAKE_DEFAULT_IMAGE=
TENSORLAKE_CPUS=
TENSORLAKE_MEMORY_MB=
TENSORLAKE_DISK_MB=
TENSORLAKE_TIMEOUT_SECONDS=900

# Set to true to keep sandboxes after a run for debugging. The UI will show
# cleanupStatus=kept.
TENSORLAKE_KEEP_SANDBOXES=false

# Where the repo gets uploaded inside the sandbox. Commands run with this as
# their working directory. Must be writable by the default sandbox user — `/tmp`
# is safe; `/workspace` is root-owned and will fail mkdir on the managed image.
TENSORLAKE_REMOTE_ROOT=/tmp/repo

# Use named sandboxes (enables suspend/resume; we don't use it yet but you can
# inspect them in the Tensorlake dashboard). Off by default → ephemeral.
TENSORLAKE_USE_NAMED_SANDBOXES=false
TENSORLAKE_SANDBOX_NAME_PREFIX=ai-fix-runner
